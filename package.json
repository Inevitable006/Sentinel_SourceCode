{
  "name": "sentinel",
  "version": "1.0.0",
  "description": "SENTINEL — Smart Engine for Natural Talk & Intelligent Local Execution. A fully local AI desktop assistant.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.sentinel.ai",
    "productName": "SENTINEL",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/sentinel.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "src/main/**/*",
      "src/preload.js",
      "frontend/dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!llama-bin.zip",
          "!llama-bin/*.dll",
          "!llama-bin/*.exe",
          "!models/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.pytest_cache/**",
          "!**/.mypy_cache/**",
          "!.env",
          "!.env.*",
          "!.git/**",
          "!tests/**",
          "!scripts/**",
          "!jarvis_desktop.py",
          "!**/*.db",
          "!**/*.sqlite",
          "!**/*.sqlite3",
          "!**/*.log",
          "!**/audit.log",
          "!**/research_history.json",
          "!**/models.json"
        ]
      }
    ]
  },
  "author": "SENTINEL Project",
  "license": "MIT",
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "electron": "^44.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "chokidar": "^5.0.0",
    "electron-store": "^10.0.0",
    "marked": "^15.0.0",
    "systeminformation": "^5.25.0"
  }
}
# Line endings: stored as LF in git, checked out natively (CRLF on Windows).
# Keeps git status clean no matter which tool or OS touches the repo.
* text=auto

# Windows scripts must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# Binary files: never convert or diff
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.gguf binary
*.onnx binary
*.db binary
